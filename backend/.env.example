# Jyotisha backend v2.0 — environment configuration
# Copy to .env and adjust. All variables use the JYOTISHA_ prefix.

# Runtime environment: development | production
JYOTISHA_ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR
JYOTISHA_LOG_LEVEL=INFO

# CORS origins (comma-separated)
JYOTISHA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Directory containing the JPL DE440 .bsp ephemeris
JYOTISHA_DATA_DIR=data

# Ephemeris file name (NASA JPL DE440)
JYOTISHA_EPHEMERIS_FILENAME=de440.bsp

# Automatically download the .bsp if missing (requires network on first boot)
JYOTISHA_AUTO_DOWNLOAD_EPHEMERIS=false

# Lunar node convention: mean | true (classical Thirukanitham default = mean)
JYOTISHA_NODE_CONVENTION=mean

# TTL for computed-result caching, in seconds
JYOTISHA_CACHE_TTL_SECONDS=300

# Maximum number of cached results (bounded LRU-style eviction)
JYOTISHA_CACHE_MAX_ENTRIES=1024
